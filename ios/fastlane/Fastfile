require "fileutils"
require "tmpdir"

default_platform(:ios)

APP_IDENTIFIER = "dev.howardism.Masquerade"

def app_version_from_pubspec
  pubspec = File.expand_path("../../pubspec.yaml", __dir__)
  File.read(pubspec)[/^version:\s*([0-9]+\.[0-9]+\.[0-9]+)/, 1]
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: true,
  )
end

def validate_signed_ipa(ipa_path:, version:, build_number:, built_after:)
  validator = File.expand_path("validate_signed_ipa.py", __dir__)
  sh(
    "python3",
    validator,
    ipa_path,
    "--expected-version",
    version,
    "--expected-build",
    build_number,
    "--app-id",
    APP_IDENTIFIER,
    "--extension-id",
    "#{APP_IDENTIFIER}.ShareExtension",
    "--team-id",
    "9KRJ83FMAF",
    "--app-group",
    "group.dev.howardism.Masquerade",
    "--built-after",
    built_after.to_s,
  )
end

platform :ios do
  # CFBundleVersion only has to be unique within one CFBundleShortVersionString,
  # so asking App Store Connect what it already has for this marketing version
  # gives a count that restarts at 1 on every release and still climbs if the
  # same version is uploaded twice. Nothing in the repo tracks it.
  desc "Resolve the next TestFlight build number for the version in pubspec.yaml"
  lane :next_build_number do
    version = app_version_from_pubspec
    UI.user_error!("No version: line in pubspec.yaml") if version.nil?

    build = latest_testflight_build_number(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0,
    ) + 1

    UI.important("Next build for #{version}: #{build}")
    out = ENV["GITHUB_OUTPUT"]
    File.write(out, "value=#{build}\n", mode: "a") if out
  end

  desc "Push a new build to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # The distribution cert is already in the keychain (imported by CI). The app
    # and extension have different bundle IDs, so each needs its own profile.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      readonly: true,
    )
    runner_profile = lane_context[SharedValues::SIGH_NAME]

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "#{APP_IDENTIFIER}.ShareExtension",
      readonly: true,
    )
    share_extension_profile = lane_context[SharedValues::SIGH_NAME]

    # The checked-in project uses automatic signing, which needs a signed-in Xcode
    # and so cannot work on a CI runner. Flip to manual for this build only --
    # ephemeral checkout, so the pbxproj edit is never committed.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "9KRJ83FMAF",
      code_sign_identity: "Apple Distribution",
      profile_name: runner_profile,
      targets: ["Runner"],
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "9KRJ83FMAF",
      code_sign_identity: "Apple Distribution",
      profile_name: share_extension_profile,
      targets: ["ShareExtension"],
    )

    version = app_version_from_pubspec
    UI.user_error!("No version: line in pubspec.yaml") if version.nil?
    build_number = ENV.fetch("FLUTTER_BUILD_NUMBER") do
      UI.user_error!("FLUTTER_BUILD_NUMBER must be set by the CI build-number step")
    end
    unless build_number.match?(/\A[0-9]+\z/)
      UI.user_error!("Invalid FLUTTER_BUILD_NUMBER: #{build_number.inspect}")
    end

    # Isolate each version/build output in a fresh directory. Fastlane's
    # IPA_OUTPUT_PATH is the sole artifact passed onward.
    output_root = ENV.fetch("FASTLANE_OUTPUT_DIR") do
      File.expand_path("../build/fastlane", __dir__)
    end
    FileUtils.mkdir_p(output_root)
    # A fresh directory avoids deleting prior artifacts and makes it impossible
    # for Fastlane to hand the validator an IPA left by an earlier attempt.
    output_directory = Dir.mktmpdir("#{version}-#{build_number}-", output_root)
    build_started_at = Time.now.to_f

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      build_path: output_directory,
      archive_path: File.join(output_directory, "Runner.xcarchive"),
      output_directory: output_directory,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => runner_profile,
          "#{APP_IDENTIFIER}.ShareExtension" => share_extension_profile,
        },
      },
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("Fastlane did not produce an IPA") if ipa_path.to_s.empty?
    validate_signed_ipa(
      ipa_path: ipa_path,
      version: version,
      build_number: build_number,
      built_after: build_started_at,
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
    )
  end
end
